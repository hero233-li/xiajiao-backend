FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /build
COPY pom.xml ./
COPY src ./src
ENV MAVEN_OPTS=-Xmx384m
RUN --mount=type=cache,target=/root/.m2 mvn -B -DargLine=-Xmx256m package

FROM eclipse-temurin:17-jre
WORKDIR /app
RUN mkdir -p /data/private && chown -R 10001:10001 /app /data
COPY --from=build --chown=10001:10001 /build/target/backend-0.0.1-SNAPSHOT.jar /app/backend.jar
USER 10001:10001
ENV APP_FILES_ROOT=/data/private
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/backend.jar"]
